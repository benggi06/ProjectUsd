#usda 1.0
(
    upAxis = "Y"
)

def "World"
{
    def Xform "AGV_0" (
        prepend references = @./assets/AGV_Asset.usda@
        variants = {
            string State = "Idle"
        }
    )
    {
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "AGV_1" (
        prepend references = @./assets/AGV_Asset.usda@
        variants = {
            string State = "Moving"
        }
    )
    {
        double3 xformOp:translate = (2, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "AGV_2" (
        prepend references = @./assets/AGV_Asset.usda@
        variants = {
            string State = "Error"
        }
    )
    {
        double3 xformOp:translate = (4, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

