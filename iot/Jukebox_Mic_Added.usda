#usda 1.0
(
    upAxis = "Y"
)

def Xform "Jukebox"
{
    def Cube "Body"
    {
        color3f[] primvars:displayColor = [(0.4, 0.25, 0.15)]
        float3 xformOp:scale = (10, 10, 10)
        uniform token[] xformOpOrder = ["xformOp:scale"]
    }

    def Sphere "Microphone"
    {
        color3f[] primvars:displayColor = [(255, 228, 0)]
        double radius = 1.5
        double3 xformOp:translate = (0, 10.0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "Camera_Sensor"
    {
        uniform token axis = "Z"
        double height = 0.5
        color3f[] primvars:displayColor = [(0.05, 0.05, 0.05)]
        double radius = 0.6
        double3 xformOp:translate = (0, 6, 10)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "Ultrasonic_Sensor"
    {
        double3 xformOp:translate = (-5, 6, 10)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "Board"
        {
            color3f[] primvars:displayColor = [(0.1, 0.1, 0.6)]
            float3 xformOp:scale = (2, 0.8, 0.1)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }

        def Cylinder "Eye_L"
        {
            uniform token axis = "Z"
            double height = 0.6
            color3f[] primvars:displayColor = [(0.8, 0.8, 0.8)]
            double radius = 0.7
            double3 xformOp:translate = (-1, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cylinder "Eye_R"
        {
            uniform token axis = "Z"
            double height = 0.6
            color3f[] primvars:displayColor = [(0.8, 0.8, 0.8)]
            double radius = 0.7
            double3 xformOp:translate = (1, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Sphere "Status_LED"
    {
        color3f[] primvars:displayColor = [(1, 0, 0)]
        double radius = 0.5
        double3 xformOp:translate = (-7.5, 6, 10.199999809265137)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "LCD_Group"
    {
        double3 xformOp:translate = (0, 2, 10)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "Frame"
        {
            color3f[] primvars:displayColor = [(0, 0.8, 0.9)]
            float3 xformOp:scale = (5, 1.5, 0.5)
            double3 xformOp:translate = (0, 0, 0.5)
            uniform token[] xformOpOrder = ["xformOp:scale", "xformOp:translate"]
        }
    }

    def Cylinder "Speaker"
    {
        uniform token axis = "Z"
        double height = 0.2
        color3f[] primvars:displayColor = [(0, 0, 0)]
        double radius = 2.5
        double3 xformOp:translate = (0, -4.5, 10)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "VolumeKnob"
    {
        uniform token axis = "Z"
        double height = 1.5
        color3f[] primvars:displayColor = [(0, 0, 0)]
        double radius = 0.5
        double3 xformOp:translate = (6, -3, 10)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "Ctrl_Button"
    {
        uniform token axis = "Z"
        double height = 0.8
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
        double radius = 0.6
        double3 xformOp:translate = (6, -6, 10)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

