#usda 1.0
(
    upAxis = "Y"
)

def Xform "Jukebox"
{
    def Cube "Body"
    {
        color3f[] primvars:displayColor = [(0.4, 0.25, 0.15)]
        float3 xformOp:scale = (10, 10, 10)
        uniform token[] xformOpOrder = ["xformOp:scale"]
    }

    def Cube "Screen_Frame"
    {
        color3f[] primvars:displayColor = [(0.1, 0.1, 0.1)]
        float3 xformOp:scale = (7, 2.5, 0.5)
        double3 xformOp:translate = (0, 2.5, 10.199999809265137)
        uniform token[] xformOpOrder = ["xformOp:scale", "xformOp:translate"]
    }

    def Cube "Screen_Content"
    {
        color3f[] primvars:displayColor = [(0, 0.2, 0.8)]
        float3 xformOp:scale = (6, 1.8, 0.1)
        double3 xformOp:translate = (0, 2.5, 10.699999809265137)
        uniform token[] xformOpOrder = ["xformOp:scale", "xformOp:translate"]
    }

    def Cylinder "Speaker"
    {
        uniform token axis = "Z"
        double height = 1
        color3f[] primvars:displayColor = [(0.8, 0.8, 0.8)]
        double radius = 2
        double3 xformOp:translate = (-4, -4, 10)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "VolumeKnob"
    {
        uniform token axis = "Z"
        double height = 2
        color3f[] primvars:displayColor = [(0.6, 0.4, 0.2)]
        double radius = 1.2
        double3 xformOp:translate = (5, -2, 10.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cylinder "Cap"
        {
            uniform token axis = "Z"
            double height = 0.2
            color3f[] primvars:displayColor = [(0.9, 0.9, 0.9)]
            double radius = 1
            double3 xformOp:translate = (0, 0, 1)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Cylinder "Button"
    {
        uniform token axis = "Z"
        double height = 1
        color3f[] primvars:displayColor = [(0.7, 0.7, 0.7)]
        double radius = 0.5
        double3 xformOp:translate = (5, -6, 10)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "Sensor_0"
    {
        uniform token axis = "Z"
        double height = 0.5
        color3f[] primvars:displayColor = [(0.1, 0.1, 0.1)]
        double radius = 0.3
        double3 xformOp:translate = (-1.5, 6, 10.199999809265137)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "Sensor_1"
    {
        uniform token axis = "Z"
        double height = 0.5
        color3f[] primvars:displayColor = [(0.1, 0.1, 0.1)]
        double radius = 0.3
        double3 xformOp:translate = (1.5, 6, 10.199999809265137)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "TopSlot"
    {
        color3f[] primvars:displayColor = [(0.1, 0.1, 0.1)]
        float3 xformOp:scale = (4, 0.2, 1.5)
        double3 xformOp:translate = (0, 10, 0)
        uniform token[] xformOpOrder = ["xformOp:scale", "xformOp:translate"]
    }
}

